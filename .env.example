# Copier vers .env si besoin. Docker Compose, les scripts npm de laboratoire (infra, reset, lab:*), `npm run dev`
# et les tests lisent .env (sans écraser les variables déjà exportées dans votre shell).
# Aucun secret réel dans ce fichier. Services liés à 127.0.0.1 : laboratoire local uniquement.
# --- Commandes (order-service) ---
PORT=3000
HOST=127.0.0.1
# Backend de /availability : http (historique TP2, défaut) ou grpc (après complétion du TP3)
STOCK_BACKEND=http
STOCK_BASE_URL=http://127.0.0.1:3001
STOCK_GRPC_TARGET=127.0.0.1:50051
STOCK_GRPC_DEADLINE_MS=500
# SESSION_SECRET=  (optionnel : secret de signature du cookie démo ; aléatoire à chaque démarrage si absent)
# --- Stocks HTTP (stock-service) ---
STOCK_PORT=3001
STOCK_HOST=127.0.0.1
STOCK_LATENCY_MS=50
STOCK_MODE=normal
STOCK_AVAILABLE=12
# --- Stocks gRPC (même processus que Stocks HTTP) ---
GRPC_STOCK_HOST=127.0.0.1
GRPC_STOCK_PORT=50051
GRPC_STOCK_LATENCY_MS=50
# --- TP4 : RabbitMQ (AMQP 5672, interface Management 15672) ---
# Identifiants FACTICES de laboratoire : refusés par les applications si NODE_ENV=production.
RABBITMQ_USER=lab
RABBITMQ_PASSWORD=lab-only-change-me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
# RABBITMQ_URL=amqp://lab:lab-only-change-me@127.0.0.1:5672   (optionnel : remplace l'URL construite ci-dessus)
# --- TP4 : PostgreSQL local (port hôte 55432 : évite un PostgreSQL déjà présent sur 5432) ---
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab-only-change-me
POSTGRES_DB=infal73_tp4_lab
POSTGRES_PORT=55432
# DATABASE_URL=postgres://lab:lab-only-change-me@127.0.0.1:55432/infal73_tp4_lab   (optionnel)
# --- TP4 : worker et laboratoire ---
# WORKER_NAME=worker-a                      (nom d'instance dans les logs ; deux workers pour T6)
# FAULT=EXIT_AFTER_COMMIT_BEFORE_ACK        (T3, laboratoire local uniquement : interdit si NODE_ENV=production)
# LAB_STATE_DIR=.lab-state                  (état des injections de panne locales, T4)
# DEV_WORKER=0                              (npm run dev ne lance pas le worker)
